# ===================================================
# GenTree Family API - Environment Variables
# ===================================================

# Database (Aiven MySQL Free Tier or Local MySQL)
# Aiven Host format: mysql-xxxx-yourname.aivencloud.com
DB_HOST=127.0.0.1
# Aiven non-standard port (e.g. 24351 or 3306)
DB_PORT=3306
# Default database in Aiven is 'defaultdb'
DB_DATABASE=family_db
# Default user in Aiven is 'avnadmin'
DB_USERNAME=root
DB_PASSWORD=your_database_password
# Set to 'true' for Aiven / Cloud MySQL requiring SSL
DB_SSL=true

# JWT Authentication
JWT_SECRET=GENTREE_SUPER_SECRET_KEY

# AWS S3 / Textract / Rekognition (Document Intelligence)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1

# AWS Cognito (Optional)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Firebase Admin SDK (Optional: raw JSON string or path to service account)
FIREBASE_CREDENTIALS=
